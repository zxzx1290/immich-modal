# Pinned to match the Immich server version. Bump this together with the
# server, then redeploy - a change here re-triggers the Modal image build.
FROM ghcr.io/immich-app/immich-machine-learning:v3.1.0 AS immich

# Use NVIDIA CUDA 12 + cuDNN 9 runtime base so libcublasLt.so.12 and cuDNN
# are present at runtime (required by onnxruntime-gpu).
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-venv \
    python3-pip \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    libmimalloc2.0 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Make python3.11 available as `python` and `python3`
RUN ln -sf /usr/bin/python3.11 /usr/local/bin/python \
 && ln -sf /usr/bin/python3.11 /usr/local/bin/python3

WORKDIR /usr/src

COPY --from=immich /opt/venv /opt/venv
COPY --from=immich /usr/src/immich_ml ./immich_ml
COPY --from=immich /usr/src/healthcheck.py ./healthcheck.py

# The venv is built with uv (no pip present). Use uv to install into the venv.
#
# 1.26.0 is the last release built against CUDA 12; 1.27.0+ link against
# libcublasLt.so.13 and silently fall back to CPU on this base image.
# It is also the version Immich itself locks for its `cuda` extra, so it stays
# in step with the onnxruntime already in the copied venv.
COPY --from=ghcr.io/astral-sh/uv:0.12.4 /uv /usr/local/bin/uv
RUN uv pip install --python /opt/venv/bin/python --no-cache \
    onnxruntime-gpu==1.26.0

# Do NOT set PATH here - Modal runtime must use system Python, not the venv.
ENV PYTHONPATH="/usr/src" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV="/opt/venv" \
    MACHINE_LEARNING_CACHE_FOLDER=/cache \
    TRANSFORMERS_CACHE=/cache \
    DEVICE=cuda
